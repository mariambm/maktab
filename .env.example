# Copy to .env for local development. Never commit .env.

# PostgreSQL
POSTGRES_DB=maktab
POSTGRES_USER=maktab
POSTGRES_PASSWORD=change-me-local-db-password

# JWT signing secret: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars

# Comma-separated browser origins allowed to call the API (empty = none).
# Example for Flutter web during development: http://localhost:5000
CORS_ALLOWED_ORIGINS=

# Spring profile. "dev" enables Swagger UI and the fake seed accounts.
SPRING_PROFILES_ACTIVE=dev

# Password for the fake development accounts (admin@maktab.local, teacher1@maktab.local, ...).
DEV_SEED_PASSWORD=change-me-dev-password
